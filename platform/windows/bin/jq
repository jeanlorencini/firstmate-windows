#!/usr/bin/env bash
# FM_WIN_JQ_SHIM: Windows overlay jq wrapper; adds -b so jq writes LF.
# jq on Windows writes CRLF, which leaves a CR on every value upstream reads.
# -b makes it write LF.
# Prefer a previously resolved real binary (env.sh / jq.sh) so PATH walking is
# skipped when the function export did not reach this process.
# Skip any other copy of this same shim on PATH: two shim directories on PATH
# used to exec each other forever, appending -b each hop.
_fm_win_jq_is_shim() {  # <path> -> 0 when path is this overlay's bash shim
  # Skip this overlay's wrapper, marked or unmarked. FM_WIN_JQ_SHIM is the
  # current marker; "jq on Windows writes CRLF" is the historical header still
  # present on pre-marker home copies. Without the historical match, a mixed
  # PATH (new worktree + old home) mutual-execs until ARG_MAX.
  local f=$1 line n=0
  [ -f "$f" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *FM_WIN_JQ_SHIM*) return 0 ;;
      *'jq on Windows writes CRLF'*) return 0 ;;
    esac
    n=$((n + 1))
    [ "$n" -lt 16 ] || break
  done <"$f"
  return 1
}

if [ -n "${FM_WIN_JQ_BIN:-}" ] && [ -x "$FM_WIN_JQ_BIN" ] \
  && ! _fm_win_jq_is_shim "$FM_WIN_JQ_BIN"; then
  exec "$FM_WIN_JQ_BIN" -b "$@"
fi
self=${BASH_SOURCE[0]%/*}
IFS=: read -r -a dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ -n "$d" ] || continue
  [ ! "$d" -ef "$self" ] || continue
  [ -x "$d/jq" ] || continue
  _fm_win_jq_is_shim "$d/jq" && continue
  exec "$d/jq" -b "$@"
done
echo "jq: not found on PATH" >&2
exit 127
